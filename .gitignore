# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#

# Unity generated
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports; *.blend1 is Blender backup junk
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size / sensitive
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin + personal settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio / Rider / VS Code / Consulo / Gradle
.vs/
.vscode/
.idea/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta of the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash / diagnostic junk
sysinfo.txt
*.stackdump
mono_crash.*
CrashReports/

# Builds / packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.dll
!Assets/**/*.dll

# Crashlytics
crashlytics-build.properties

# TestRunner / Play Mode test scenes
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# UI Toolkit / scene cache
/UIElementsSchema/
/[Aa]ssets/[Ss]ceneDependencyCache*

# Plastic / Unity Collaborate leftovers
ignore.conf
*.private
*.private.meta
.collabignore

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Python tooling under Tools/
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local art/pipeline scratch (previews, rembg, chroma experiments)
/_tmp_*/

# Local codegraph index (if you run `codegraph init`)
.codegraph/

#others
tools/
